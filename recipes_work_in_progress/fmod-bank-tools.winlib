export NAME="Fmod-Bank-Tools"
export STATUS=
export URL=https://github.com/Wouldubeinta/Fmod-Bank-Tools
export BASENAME=fmod-bank-tools
export DESCRIPTION="Extracts and Rebuilds Fmod .bank files."
export CATEGORY=fileformat
export TYPE=application
export VERSION=2.2.4.29
export VERSIONDATE=20260805
wl-showstatus --package-version
export DEPENDENCIES=qt6
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=GPL
export DOWNLOADURL="https://github.com/Wouldubeinta/Fmod-Bank-Tools/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/Wouldubeinta/Fmod-Bank-Tools/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd Fmod-Bank-Tools-$VERSION

wl-showstatus configure &&
 $MINGWPREFIX/qt/bin/qmake -makefile *.pro -spec $MINGWPREFIX/qt/mkspecs/win32-g++ &&
 wl-showstatus build &&
 mingw32-make &&
    echo OK

wl-showstatus configure &&
 $MINGWPREFIX/qt6/bin/qmake -makefile *.pro -spec $MINGWPREFIX/qt6/mkspecs/win32-g++ &&
 wl-showstatus build &&
 mingw32-make &&
    echo OK

