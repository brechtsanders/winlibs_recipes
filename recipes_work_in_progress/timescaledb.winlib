export NAME="TimescaleDB"
export STATUS=
export URL=https://www.tigerdata.com/
#export URL=https://github.com/timescale/timescaledb
export BASENAME=timescaledb
export DESCRIPTION="TimescaleDB is a PostgreSQL extension for high-performance real-time analytics on time-series and event data"
export CATEGORY=database
export TYPE=library
export VERSION=2.31.0
export VERSIONDATE=20261108
wl-showstatus --package-version
export DEPENDENCIES=openssl
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=Apache
export DOWNLOADURL="https://github.com/timescale/timescaledb/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/timescale/timescaledb/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix src/version.c (version >= 2.31.0)
patch -ulbf src/version.c << EOF
@@ -124,3 +124,3 @@

-       if (!VerQueryValueA(buffer, TEXT("\\\\"), &vinfo, &vinfo_len))
+       if (!VerQueryValueA(buffer, TEXT("\\\\"), (void**)&vinfo, &vinfo_len))
        {
EOF
# fix invalid linker flags in src/build-defs.cmake (version >= 2.31.0)
patch -ulbf src/build-defs.cmake << EOF
@@ -24,3 +24,3 @@
   )
-elseif(WIN32)
+elseif(MSVC)
   set(CMAKE_SHARED_LINKER_FLAGS "\${CMAKE_SHARED_LINKER_FLAGS} /MANIFEST:NO")
@@ -52,3 +52,3 @@
   set(CMAKE_MODULE_LINKER_FLAGS
-      "\${CMAKE_MODULE_LINKER_FLAGS} \${PG_LIBDIR}/postgres.lib ws2_32.lib Version.lib"
+      "\${CMAKE_MODULE_LINKER_FLAGS} -L\${PG_LIBDIR} -lpq -lpgport -lpgcommon -lws2_32 -lversion"
   )
EOF
# fix invalid linker flag in tsl/src/build-defs.cmake (version >= 2.31.0)
patch -ulbf tsl/src/build-defs.cmake << EOF
@@ -22,3 +22,3 @@
   )
-elseif(WIN32)
+elseif(MSVC)
   set(CMAKE_SHARED_LINKER_FLAGS "\${CMAKE_SHARED_LINKER_FLAGS} /MANIFEST:NO")
EOF

