export NAME="quickdlna"
export STATUS=
export URL=https://github.com/sanjayrao77/quickdlna
export BASENAME=quickdlna
export DESCRIPTION="A DLNA media server you can run from the command line w/o root permissions. Can be used with the Roku Media Player app."
export CATEGORY=multimedia
export TYPE=application
export VERSION=main
export VERSIONDATE=20260801
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=imagemagick
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=GPL
export DOWNLOADURL="https://github.com/sanjayrao77/quickdlna/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/sanjayrao77/quickdlna/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix Makefile
sed -i.bak -e "s/\bgcc /\$(CC) /" Makefile
wl-showstatus build &&
 sed -e "s/ICONNAME/Quick/" icon.svg > Quick.svg &&
 MAGICK_CODER_MODULE_PATH=$MINGWPREFIX/lib/ImageMagick-$(magick -version|sed -ne "s/^.*ImageMagick \([0-9]*\.[0-9]*\.[0-9]*\).*$/\1/p")/modules-Q16HDRI/coders \
 MAGICK_CODER_FILTER_PATH=$MINGWPREFIX/lib/ImageMagick-$(magick -version|sed -ne "s/^.*ImageMagick \([0-9]*\.[0-9]*\.[0-9]*\).*$/\1/p")/modules-Q16HDRI/filters \
 $MINGWPREFIX/bin/magick.exe -size 120x120 Quick.svg icon.png &&
 $PYDIR/python.exe mkiconc.py > icon.c &&
 make CC="${CC:-gcc}" &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



