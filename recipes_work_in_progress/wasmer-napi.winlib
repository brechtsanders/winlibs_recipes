export NAME="Wasmer NAPI"
export STATUS=
export URL=https://github.com/wasmerio/napi
export BASENAME=wasmer-napi
export DESCRIPTION="NAPI library for Wasmer WebAssembly runtime"
export CATEGORY=development
export TYPE=library
export VERSION=main
export VERSIONDATE=20260909
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/wasmerio/napi/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/wasmerio/napi/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd napi-$VERSION

  ./configure --help 2> /dev/null
  cat meson_options.txt 2> /dev/null
  head COPYING* LICENSE* LICENCE* COPYRIGHT*
  ls -ld COPYING* LICENSE* LICENCE* COPYRIGHT* configure* m4 CMakeLists.txt cmake xmake.lua Makefile GNUmakefile setup.py scons SConscript SConstruct meson.build meson_options.txt meson.options.txt *.pro *.proj *.sln BUILD.gn .gn MODULE.bazel Cargo.toml build 2> /dev/null

wl-showstatus build &&
 CARGO_HOME=${CARGO_HOME:-$PWD/rustdeps} PATH=$MINGWPREFIX/share/rust/bin:$PATH make &&
 #make CC="${CC:-gcc}" CXX="${CXX:-g++}" LD="${LD:-ld}" AR="${AR:-ar}" &&
 #make CC="$(echo ${CC:-gcc}|sed "s/ .*$//")" CFLAGS="$(echo ${CC:-gcc}|sed "s/^[^ ]*//")" CXX="$(echo ${CXX:-g++}|sed "s/ .*$//")" CXXFLAGS="$(echo ${CXX:-g++}|sed "s/^[^ ]*//")" LD="${LD:-ld}" AR="${AR:-ar}" 
    echo OK

#grep -wi add_library $(find -name CMakeLists.txt -or -name '*.cmake')
mkdir -p build_test && cmake.exe -Wno-dev -G"MSYS Makefiles" -DNAPI_BUILD_V8:BOOL=OFF -DNAPI_BUILD_QUICKJS:BOOL=OFF -DNAPI_BUILD_BUNDLED_QUICKJS:BOOL=OFF -DFETCHCONTENT_FULLY_DISCONNECTED:BOOL=ON -DNAPI_V8_BUILD_TESTS:BOOL=OFF -S. -Bbuild_test -LH && echo OK; rm -rf build_test
