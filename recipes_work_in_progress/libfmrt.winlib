export NAME="libfmrt"
export STATUS=
export URL=https://github.com/Roberto-Mameli/libfmrt
export BASENAME=libfmrt
export DESCRIPTION="libfmrt is a software library written in C, which can be linked (either statically or dynamically) to C/C++ source code. It gives the ability to store huge amount of data into in-memory tables, providing high efficiency and O(log2N) complexity. To achieve this requirement, in-memory data are stored into tables organized as AVL trees."
export CATEGORY=dataprocessing,development
export TYPE=library
export VERSION=1.0.0
export VERSIONDATE=20260731
wl-showstatus --package-version
export DEPENDENCIES=date-time
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE.txt
export LICENSETYPE=Apache
export DOWNLOADURL="https://github.com/Roberto-Mameli/libfmrt/tags v."
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/Roberto-Mameli/libfmrt/archive/refs/tags/v.$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v.$VERSION.tar.gz
cd libfmrt-v.$VERSION
# fix missing strptime in src/fmrtApi.c
sed -i.bak -e "1i #include <time_local.h>\n#define strptime ya_strptime" src/fmrtApi.c
wl-showstatus build &&
 make CC="${CC:-gcc}" AR="${AR:-ar}" &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf libfmrt-v.$VERSION



