export NAME="litebrowser-linux"
export STATUS=
export URL=https://github.com/litehtml/litebrowser-linux
export BASENAME=litebrowser-linux
export DESCRIPTION="A simple browser based on the litehtml engine for Linux and Mac."
export CATEGORY=communication
export TYPE=application
export VERSION=master
export VERSIONDATE=20260818
wl-showstatus --package-version
export DEPENDENCIES=litehtml,gtkmm4,libcurl,cairo,pango
export OPTIONALDEPENDENCIES=libadwaita
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=BSD
export DOWNLOADURL="https://github.com/litehtml/litebrowser-linux/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/litehtml/litebrowser-linux/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION

