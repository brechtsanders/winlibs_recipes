export NAME="libmatoya"
export STATUS=
export URL=https://github.com/snowcone-ltd/libmatoya
export BASENAME=libmatoya
export DESCRIPTION="libmatoya is a cross-platform application development library."
export CATEGORY=portability
export TYPE=library
export VERSION=master
export VERSIONDATE=20260801
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/snowcone-ltd/libmatoya/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/snowcone-ltd/libmatoya/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix missing files
cp -rn src/windows/gfx/* src/gfx
#cp -n src/unix/linux/rwlockattr.h src/unix/
cp -n src/unix/web/rwlockattr.h src/unix/
cat > src/unix/home.h << EOF
#pragma once

#include <shlobj.h>

static bool home_get_dir(char *dir, size_t size)
{
  char path[MAX_PATH];
  if (SHGetFolderPathW(NULL, CSIDL_PROFILE, NULL, 0, path) == S_OK) {
    if (strlen(path) < size) {
      strcpu(dir, path);
      return true;
    }
  }
  return false;
}
EOF
wl-showstatus build &&
 make -fGNUmakefile CC="${CC:-gcc}" AR="${AR:-ar}" &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



