export NAME="litebrowser"
export STATUS=
export URL=https://github.com/litehtml/litebrowser
export BASENAME=litebrowser
export DESCRIPTION="Litebrowser is simple web browser designed to test the litehtml HTML rendering engine."
export CATEGORY=communication
export TYPE=application
export VERSION=0.3
export VERSIONDATE=20260818
wl-showstatus --package-version
export DEPENDENCIES=litehtml,txdib,simpledib,cairo
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=BSD
export DOWNLOADURL="https://github.com/litehtml/litebrowser/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/litehtml/litebrowser/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION

mkdir -p containers/windows/cairo containers/cairo
echo "#include <litehtml/litehtml.h>" > containers/windows/cairo/windows_container.h
touch containers/windows/cairo/cairo_font.h
touch containers/cairo/cairo_images_cache.h
wl-showstatus build &&
 touch SUCCESS &&
 for F in src/*.cpp; do
  echo CXX $F
  ${CXX:-g++} -c -o $F.o $F -Isrc -I. -I$MINGWPREFIX/include/litehtml -I$MINGWPREFIX/include/simpledib $(${PKG_CONFIG:-pkg-config} --cflags cairo) || ( rm -f SUCCESS; false ) || break
 done &&
 rm SUCCESS &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



