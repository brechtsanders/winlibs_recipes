export NAME="srs"
export STATUS=
export URL=https://ossrs.io/
#export URL=https://github.com/ossrs/srs
export BASENAME=srs
export DESCRIPTION="SRS is a simple, high efficiency and realtime video server, supports RTMP, WebRTC, HLS, HTTP-FLV, SRT, MPEG-DASH and GB28181. SRS Stack is an all-in-one, out-of-the-box, and open-source video solution for creating online video services, including live streaming and WebRTC, on the cloud or through self-hosting."
export CATEGORY=video
export TYPE=application
#export VERSION=6.0-d4
#export VERSIONDATE=20240403
#export VERSION=6.0-d5
#export VERSIONDATE=20240615
#export VERSION=6.0-d6
#export VERSIONDATE=20240704
#export VERSION=6.0-a0
#export VERSIONDATE=20240727
#export VERSION=6.0-a1
#export VERSIONDATE=20240901
#export VERSION=6.0-a2
#export VERSIONDATE=20250504
#export VERSION=6.0-b0
#export VERSIONDATE=20250813
#export VERSION=6.0-b1
#export VERSIONDATE=20250916
#export VERSION=6.0-b2
#export VERSIONDATE=20251017
#export VERSION=6.0-b3
#export VERSIONDATE=20251104
#export VERSION=6.0-r0
#export VERSIONDATE=20251204
#export VERSION=7.0-d0
#export VERSIONDATE=20260812
export VERSION=7.0-a0
export VERSIONDATE=20260919
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=go
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/ossrs/srs/releases"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/ossrs/srs/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
wl-showstatus build &&
 PATH=$MINGWPREFIX/go/bin:$PATH make &&
 mv -f bin/srs-proxy bin/srs-proxy.exe &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/bin &&
 cp -f bin/*.exe $INSTALLPREFIX/bin/ &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



