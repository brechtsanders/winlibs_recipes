export NAME="pinusdb"
export STATUS=
export URL=https://github.com/pinusdb/pinusdb
export BASENAME=pinusdb
export DESCRIPTION="Time Series Database"
export CATEGORY=database
export TYPE=library
export VERSION=3.0.1
export VERSIONDATE=20261108
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/pinusdb/pinusdb/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/pinusdb/pinusdb/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# also allow building static library
sed -i.bak -e "s/\(add_library([^ ]*\) SHARED/\1/" src/pdb_csdk/CMakeLists.txt
# fix src/pinusdb/CMakeLists.txt (version >= 3.0.1)
patch -ulbf src/pinusdb/CMakeLists.txt << EOF
@@ -9,6 +9,6 @@

-IF (CMAKE_SYSTEM_NAME MATCHES "Linux")
+IF (CMAKE_SYSTEM_NAME MATCHES "Linux" OR MINGW)
   set(CMAKE_CXX_STANDARD 17)
   add_definitions(-Wall -O2)
-ELSEIF (CMAKE_SYSTEM_NAME MATCHES "Windows")
+ELSEIF (MSVC)
   add_compile_options("/std:c++17")
EOF

