export NAME="SNACC"
export STATUS=
export URL=https://git.openldap.org/openldap/snacc
export BASENAME=snacc
export DESCRIPTION="eSNACC (Enhanced SNACC) - tool that parses Abstract Syntax Notation One (ASN.1) files and generates corresponding source and header code in C, C++, or other target languages to serialize and deserialize structured data."
export CATEGORY=fileformat,development
export TYPE=application
export VERSION=2.3.6
export VERSIONDATE=20260807
wl-showstatus --package-version
export DEPENDENCIES=tcl
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=copying
export LICENSETYPE=GPL
export DOWNLOADURL="https://git.openldap.org/openldap/snacc/-/tags"
#export DOWNLOADURL="https://www.openldap.org/software/download/OpenLDAP/openldap-release/"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://git.openldap.org/openldap/snacc/-/archive/OPENLDAP_REL_ENG_$(echo $VERSION|tr . _)/snacc-OPENLDAP_REL_ENG_$(echo $VERSION|tr . _).tar.bz2
#export DOWNLOADSOURCEURL=https://www.openldap.org/software/download/OpenLDAP/openldap-release/openldap-snacc-$VERSION.tgz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xj --force-local -f $TARBALLDIR/$BASENAME/snacc-OPENLDAP_REL_ENG_$(echo $VERSION|tr . _).tar.bz2
#tar xz --force-local -f $TARBALLDIR/$BASENAME/openldap-snacc-$VERSION.tgz
cd snacc-OPENLDAP_REL_ENG_$(echo $VERSION|tr . _)
# fix missing strcmp() in compiler/core/meta.c
sed -i.bak -e "1i #include <string.h>" compiler/core/meta.c
wl-showstatus configure &&
 ./configure --prefix=$INSTALLPREFIX --build=$BUILDPLATFORM --host=$RUNPLATFORM --enable-tcl --enable-meta --without-x &&
 wl-showstatus build &&
 make &&
 wl-showstatus build-install &&
 make install-strip &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf snacc-OPENLDAP_REL_ENG_$(echo $VERSION|tr . _)



