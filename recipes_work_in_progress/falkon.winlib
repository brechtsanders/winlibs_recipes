export NAME="Falkon"
export STATUS=
export URL=https://www.falkon.org/
export BASENAME=falkon
export DESCRIPTION="Cross-platform Qt-based web browser"
export CATEGORY=internet
export TYPE=application
export VERSION=26.08.1
export VERSIONDATE=20260925
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=COPYING
export LICENSETYPE=GPL
export DOWNLOADURL="https://invent.kde.org/network/falkon/-/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://invent.kde.org/network/falkon/-/archive/v$VERSION/falkon-v$VERSION.tar.bz2
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xj --force-local -f $TARBALLDIR/$BASENAME/falkon-v$VERSION.tar.bz2
cd falkon-v$VERSION

