export NAME="AGAVE pathtrace viewer"
export STATUS=
export URL=https://www.allencell.org/pathtrace-rendering.html
#export URL=https://github.com/AllenCell/agave
export BASENAME=agave-pathtrace
export DESCRIPTION="AGAVE is a desktop application for viewing multichannel volume data. Several formats are supported, including OME-ZARR 0.4 and 0.5, OME-TIFF and Zeiss .czi files."
export CATEGORY=vizualisation
export TYPE=application
export VERSION=1.10.0
export VERSIONDATE=20260908
wl-showstatus --package-version
export DEPENDENCIES=zlib,libtiff,libczi,libcurl,vulkan-headers,qt6,fmt,spdlog
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=GPL
export DOWNLOADURL="https://github.com/AllenCell/agave/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/AllenCell/agave/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd agave-$VERSION

cat > renderlib/io/libCZI/CMakeLists.txt << EOF
#if(NOT BUILD_SHARED_LIBS)
#add_library(libCZI STATIC IMPORTED)
#else()
#add_library(libCZI SHARED IMPORTED)
#endif()
add_library(libCZI UNKNOWN IMPORTED)
#add_library(nanoarrow_static ALIAS nanoarrow)
EOF

