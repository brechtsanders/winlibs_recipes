export NAME="Ginkgo CADx"
export STATUS=
export URL=https://github.com/gerddie/ginkgocadx
export BASENAME=ginkgocadx
export DESCRIPTION="Advanced DICOM viewer"
export CATEGORY=
export TYPE=library
export VERSION=3.8.8
export VERSIONDATE=20260802
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LGPL3.txt
export LICENSETYPE=LGPL
export DOWNLOADURL="https://github.com/gerddie/ginkgocadx/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/gerddie/ginkgocadx/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix CMake/SysDefs.cmake (version >= 3.8.8)
patch -ulbf CMake/SysDefs.cmake << EOF
@@ -9,5 +9,5 @@
        SET(OS "Windows")
-       SET(ARCH "x86")
+       #SET(ARCH "x86")
        SET(WINDOWS TRUE)
-       INCLUDE(WinPackage)
+       #INCLUDE(WinPackage)

EOF
# fix CMakeLists.txt (version >= 3.8.8)
patch -ulbf CMakeLists.txt << EOF
@@ -68,3 +68,4 @@
 #ENDIF()
-SET_CUSTOM_libcurl_PACKAGE()
+#SET_CUSTOM_libcurl_PACKAGE()
+FIND_PACKAGE(CURL REQUIRED)

EOF

#grep -wi add_library $(find -name CMakeLists.txt -or -name '*.cmake')
mkdir -p build_test && cmake.exe -Wno-dev -G"MSYS Makefiles" -DUSE_CUSTOM_DCMTK:BOOL=OFF -DUSE_CUSTOM_ITK:BOOL=OFF -DUSE_CUSTOM_VTK:BOOL=OFF -DUSE_CUSTOM_WX:BOOL=OFF -DUSE_PATCHED_LIBS:BOOL=ON -DUSE_SYSTEM_SQLITE:BOOL=ON -DBUILD_VISUALIZATION_EXT:BOOL=ON -DCMAKE_MODULE_PATH:PATH=$MINGWPREFIX/wx/lib/cmake/wxWidgets-3.3 -DwxWidgets_INCLUDE_DIRS:PATH=$MINGWPREFIX/wx/include -DwxWidgets_LIBRARIES:PATH=$MINGWPREFIX/wx/wx/lib/gcc_dll/libwxmsw33u.a -DCMAKE_POLICY_VERSION_MINIMUM:STRING=3.5 -S. -Bbuild_test -LH && echo OK; rm -rf build_test
