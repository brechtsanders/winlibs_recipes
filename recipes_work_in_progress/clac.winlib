export NAME="Clac"
export STATUS=
export URL=https://github.com/soveran/clac
export BASENAME=clac
export DESCRIPTION="A command line, stack-based calculator with postfix notation that displays the stack contents at all times. As you type, the stack changes are reflected immediately."
export CATEGORY=math
export TYPE=application
export VERSION=0.3.5
export VERSIONDATE=20260912
wl-showstatus --package-version
export DEPENDENCIES=sds,linenoise
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=BSD
export DOWNLOADURL="https://github.com/soveran/clac/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/soveran/clac/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
wl-showstatus build &&
 ${CC:-gcc} -c -o clac.o clac.c -Os -Wall &&
 ${CC:-gcc} -o clac.exe clac.o -lsds -llinenoise -s -Wall -Os &&
 make CC="${CC:-gcc}" &&
    echo OK
wl-showstatus build-install &&
 make install PREFIX=$INSTALLPREFIX &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



