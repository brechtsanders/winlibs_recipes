export NAME="Scinterm"
export STATUS=
export URL=https://orbitalquark.github.io/scinterm/
#export URL=https://github.com/orbitalquark/scinterm
export BASENAME=scinterm
export DESCRIPTION="Scinterm is a curses platform for Scintilla that supports ncurses(w), PDCurses, and X/Open Curses."
export CATEGORY=
export TYPE=library
export VERSION=6.0
export VERSIONDATE=20261101
wl-showstatus --package-version
export DEPENDENCIES=ncurses
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/orbitalquark/scinterm/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/orbitalquark/scinterm/archive/refs/tags/scinterm_$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/scinterm_$VERSION.tar.gz
cd scinterm-scinterm_$VERSION
wl-showstatus build &&
 make sci="$MINGWPREFIX/lib/libscintilla.dll.a" CURSES_FLAGS="$(${PKG_CONFIG:-pkg-config} --cflags ncurses)" CC="${CC:-gcc}" CXX="${CXX:-g++}" AR="${AR:-ar}" &&
 make -Cjinx scintilla="$MINGWPREFIX/lib/libscintilla.dll.a $MINGWPREFIX/lib/liblexilla.dll.a" CC="${CC:-gcc} -I$MINGWPREFIX/include/libdl-win32 $(${PKG_CONFIG:-pkg-config} --cflags ncurses)" CXX="${CXX:-g++}" &&
 #make CC="${CC:-gcc}" CXX="${CXX:-g++}" LD="${LD:-ld}" AR="${AR:-ar}" &&
 #make CC="$(echo ${CC:-gcc}|sed "s/ .*$//")" CFLAGS="$(echo ${CC:-gcc}|sed "s/^[^ ]*//")" CXX="$(echo ${CXX:-g++}|sed "s/ .*$//")" CXXFLAGS="$(echo ${CXX:-g++}|sed "s/^[^ ]*//")" LD="${LD:-ld}" AR="${AR:-ar}" 
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf scinterm-scinterm_$VERSION



