export NAME="GreptimeDB"
export STATUS=
export URL=https://greptime.com/product/db
#export URL=https://github.com/greptimeteam/greptimedb
export BASENAME=greptimedb
export DESCRIPTION="The open-source observability database. One columnar engine for metrics, logs, and traces, on object storage."
export CATEGORY=database
export TYPE=application
#export VERSION=1.2.0
#export VERSIONDATE=20260908
export VERSION=1.2.1
export VERSIONDATE=20261005
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=rust
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
#export LICENSEFILE=LICENSE-ENTERPRISE
export LICENSETYPE=Apache
export DOWNLOADURL="https://github.com/GreptimeTeam/greptimedb/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/GreptimeTeam/greptimedb/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
#export GIT_SSL_NO_VERIFY=true
wl-showstatus build &&
 GIT_CONFIG_GLOBAL=config GIT_SSL_NO_VERIFY=true CARGO_NET_GIT_FETCH_WITH_CLI=true \
 CARGO_HOME=${CARGO_HOME:-$PWD/rustdeps} PATH=$MINGWPREFIX/share/rust/bin:$PATH \
 cargo build --profile release &&
 wl-showstatus install &&
 #GIT_CONFIG_GLOBAL=config GIT_SSL_NO_VERIFY=true CARGO_NET_GIT_FETCH_WITH_CLI=true \
 CARGO_HOME=${CARGO_HOME:-$PWD/rustdeps} PATH=$MINGWPREFIX/share/rust/bin:$PATH \
 cargo install --root $INSTALLPREFIX --profile release --path . &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



