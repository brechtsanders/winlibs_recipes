export NAME="weechat"
export STATUS=
export URL=https://weechat.org/
#export URL=https://github.com/weechat/weechat
export BASENAME=weechat
export DESCRIPTION="WeeChat, the extensible chat client."
export CATEGORY=communication
export TYPE=application
#export VERSION=4.9.4
#export VERSIONDATE=20260726
export VERSION=4.9.5
export VERSIONDATE=20260727
wl-showstatus --package-version
export DEPENDENCIES=libiconv,gettext,zlib,zstd,libcrypt,libgcrypt,gnutls,cjson,libcurl,ncurses,tcl,tk,libdl,sys_wait_h
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja,ruby
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=COPYING
export LICENSETYPE=GPL
export DOWNLOADURL="https://github.com/weechat/weechat/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/weechat/weechat/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix missing files
mkdir -p winfix/sys
cat > winfix/sys/socket.h << EOF
#include <winsock2.h>
#include <ws2tcpip.h>
EOF
## fix src/plugins/weechat-plugin.h (version >= 4.9.4)
#patch -ulbf src/plugins/weechat-plugin.h << EOF
#@@ -34,3 +34,8 @@
# #include <sys/types.h>
#+#ifdef _WIN32
#+#include <winsock2.h>
#+#include <ws2tcpip.h>
#+#else
# #include <sys/socket.h>
#+#endif
#
#EOF
# fix missing realpath() in src/plugins/plugin-api-info.c (version >= 4.9.4)
sed -i.bak -e "1i #define realpath(N,R) _fullpath((R),(N),_MAX_PATH)" src/plugins/plugin-api-info.c
# avoid symlink() in src/plugins/plugin-script.c (version >= 4.9.4)
patch -ulbf src/plugins/plugin-script.c << EOF
@@ -1340,2 +1340,3 @@
                             {
+#ifndef _WIN32
                                 if (weechat_asprintf (&autoload_path,
@@ -1359,2 +1360,3 @@
                                 }
+#endif
                             }
@@ -1539,2 +1541,3 @@
                         {
+#ifndef _WIN32
                             dir_separator = weechat_info_get ("dir_separator", "");
@@ -1550,2 +1553,3 @@
                             free (dir_separator);
+#endif
                         }
EOF
# fix undefined SIGWINCH in src/gui/curses/gui-curses-main.c (version >= 4.9.4)
patch -ulbf src/gui/curses/gui-curses-main.c << EOF
@@ -401,3 +401,5 @@
         gui_signal_sigwinch_received = 1;
+#ifdef SIGWINCH
         signal_catch (SIGWINCH, &gui_main_signal_sigwinch);
+#endif
     }
EOF
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DENABLE_NCURSES:BOOL=OFF -DENABLE_PERL:BOOL=OFF -DENABLE_PHP:BOOL=OFF -DENABLE_JAVASCRIPT:BOOL=OFF -DENABLE_TESTS:BOOL=OFF -DPython_EXECUTABLE:FILEPATH=$PYDIR/python.exe -DCMAKE_C_FLAGS:STRING="-D_POSIX_THREAD_SAFE_FUNCTIONS -I$(cygpath -m $PWD/winfix) -I$(cygpath -m $MINGWPREFIX/include/libdl-win32) -I$(cygpath -m $MINGWPREFIX/win32ports/include)" -S. -Bbuild_win &&
 wl-showstatus build-install &&
 ninja -Cbuild_win install/strip &&
    echo OK

