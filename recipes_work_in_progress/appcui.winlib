export NAME="AppCUI"
export STATUS=
export URL=https://gdt050579.github.io/AppCUI/
#export URL=https://github.com/gdt050579/AppCUI
export BASENAME=appcui
export DESCRIPTION="AppCUI is a cross-platform TUI builder. The users of this library can construct an interface using its basic building blocks such as: Window, Button, Label, etc."
export CATEGORY=tui
export TYPE=library
export VERSION=1.241.0
export VERSIONDATE=20261009
wl-showstatus --package-version
export DEPENDENCIES=zlib,libbz2,libjpeg,libpng,libjpeg-turbo,freetype2,sdl2,sdl2ttf,brotli
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/gdt050579/AppCUI/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/gdt050579/AppCUI/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix missing #include <algorithm>
sed -i.bak -e "1i #include <algorithm>" Examples/Snake/Board.cpp Examples/Tetris/Board.cpp AppCUI/src/Controls/TreeView.cpp AppCUI/src/Utils/IniObject.cpp
sed -i.bak -e "1i #include <chrono>" Examples/TreeView/main.cpp
# fix AppCUI/include/AppCUI.hpp (version >= 1.241.0)
patch -ulbf AppCUI/include/AppCUI.hpp << EOF
@@ -40,3 +40,7 @@
 #    ifdef BUILD_FOR_WINDOWS
+#      ifdef AppCUI_EXPORTS
 #        define EXPORT __declspec(dllexport)
+#      else
+#        define EXPORT __declspec(dllimport)
+#      endif
 #    else
EOF
# also allow building static library
sed -i.bak -e "s/\(add_library([^ ]*\) SHARED/\1/" AppCUI/CMakeLists.txt
# fix AppCUI/CMakeLists.txt (version >= 1.241.0)
#sed -i.bak -e "s/\(find_package(\)unofficial-\(brotli\)/\1\2/" AppCUI/CMakeLists.txt
patch -ulbf AppCUI/CMakeLists.txt << EOF
@@ -38,3 +38,5 @@
 set_target_properties(\${PROJECT_NAME} PROPERTIES PREFIX "lib")
+if(BUILD_SHARED_LIBS)
 target_compile_definitions(\${PROJECT_NAME} PRIVATE -DBUILD_AS_DYNAMIC_LIB)
+endif()

@@ -51,3 +53,9 @@

-find_package(unofficial-brotli CONFIG REQUIRED)
+find_package(unofficial-brotli CONFIG)
+if (NOT TARGET unofficial-brotli)
+  find_package(PkgConfig QUIET)
+  if(PkgConfig_FOUND)
+    pkg_check_modules(unofficial-brotli libbrotlicommon REQUIRED)
+  endif()
+endif()
 find_package(BZip2 REQUIRED)
EOF
# fix CMakeLists.txt (version >= 1.241.0)
patch -ulbf CMakeLists.txt << EOF
@@ -2,4 +2,2 @@

-set(CMAKE_TOOLCHAIN_FILE "\${CMAKE_CURRENT_SOURCE_DIR}/vcpkg/scripts/buildsystems/vcpkg.cmake"
-  CACHE STRING "Vcpkg toolchain file")

@@ -25,2 +23,4 @@
     add_compile_options(-W3 /MP)
+elseif (WIN32)
+    add_definitions(-DBUILD_FOR_WINDOWS)
 elseif (APPLE)
EOF

