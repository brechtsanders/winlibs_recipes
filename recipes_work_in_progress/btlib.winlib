export NAME="btlib"
export STATUS=
export URL=https://github.com/mpwillson/btlib
export BASENAME=btlib
export DESCRIPTION="B-Tree Library"
export CATEGORY=dataprocessing
export TYPE=library
export VERSION=5.0.2
export VERSIONDATE=20261016
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=GPL
export DOWNLOADURL="https://github.com/mpwillson/btlib/releases"
#export DOWNLOADURL="https://github.com/mpwillson/btlib/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/mpwillson/btlib/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
wl-showstatus build &&
 make CC="${CC:-gcc}" AR="${AR:-ar}" &&
 #make CC="${CC:-gcc}" CXX="${CXX:-g++}" LD="${LD:-ld}" AR="${AR:-ar}" &&
 #make CC="$(echo ${CC:-gcc}|sed "s/ .*$//")" CFLAGS="$(echo ${CC:-gcc}|sed "s/^[^ ]*//")" CXX="$(echo ${CXX:-g++}|sed "s/ .*$//")" CXXFLAGS="$(echo ${CXX:-g++}|sed "s/^[^ ]*//")" LD="${LD:-ld}" AR="${AR:-ar}" 
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



