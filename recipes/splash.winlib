export NAME="SPLASH"
export STATUS=
export URL=https://users.monash.edu.au/~dprice/splash/
export BASENAME=splash
export DESCRIPTION="SPLASH is a free and open source visualisation tool for Smoothed Particle Hydrodynamics (SPH) simulations in one, two and three dimensions, developed mainly for astrophysics. It uses a command-line menu but data can be manipulated interactively in the plotting window."
export CATEGORY=science
export TYPE=application
#export VERSION=3.12.0
#export VERSIONDATE=20260829
#export VERSION=4.0.0
#export VERSIONDATE=20260831
export VERSION=4.0.1
export VERSIONDATE=20260930
wl-showstatus --package-version
export DEPENDENCIES=giza
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=GPL
export DOWNLOADURL="https://github.com/danieljprice/splash/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/danieljprice/splash/releases/download/v$VERSION/splash-v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
mkdir -p $BASENAME-$VERSION
tar xz --force-local -f $TARBALLDIR/$BASENAME/splash-v$VERSION.tar.gz -C$BASENAME-$VERSION
cd $BASENAME-$VERSION/splash
mkdir -p $INSTALLPREFIX/include
# don't use missing setenv in src/system_utils.f90 (version >= 4.0.0)
patch -ulbf src/system_utils.f90 << EOF
@@ -73,3 +73,3 @@

- ierr = setenv(cstring(variable),cstring(string),1)
+ ierr = -1
  if (present(stat)) stat = ierr
EOF
wl-showstatus build &&
 mingw32-make PREFIX=$MINGWPREFIX CC="${CC:-gcc}" CXX="${CXX:-g++}" FC="${FC:-gfortran}" &&
 strip bin/*.exe &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/bin
 mingw32-make install PREFIX=$INSTALLPREFIX &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd ../.. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION
####$MINGWPREFIX/bin/splash.exe --help



