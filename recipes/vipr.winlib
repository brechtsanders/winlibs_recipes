export NAME="vipr"
export STATUS=
export URL=https://github.com/scipopt/vipr
export BASENAME=vipr
export DESCRIPTION="VIPR is a software project to verify, in exact rational arithmetic, the correctness of results computed by mixed-integer linear programming solvers."
export CATEGORY=math
export TYPE=application
export VERSION=master
export VERSIONDATE=20261004
wl-showstatus --package-version
export DEPENDENCIES=zlib,gmp,mpfr,soplex,tbb,papilo,boost
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=
export LICENSETYPE=
export DOWNLOADURL="https://github.com/scipopt/vipr/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/scipopt/vipr/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -Scode -Bbuild_win &&
 # fix missing -lpapilo
 #sed -i.bak -e "s/-lpapilo /-lpapilo-core /" build_win/build.ninja &&
 sed -i.bak -e "s/-lpapilo /-lpapilo-core -lclusol/" build_win/build.ninja &&
 wl-showstatus build &&
 ninja -Cbuild_win &&
 wl-showstatus install &&
 strip build_win/*.exe &&
 mkdir -p $INSTALLPREFIX/bin &&
 cp -f build_win/*.exe $INSTALLPREFIX/bin &&
 #wl-showstatus build-install &&
 #ninja -Cbuild_win install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



