export NAME="simpledib"
export STATUS=
export URL=https://github.com/tordex/simpledib
export BASENAME=simpledib
export DESCRIPTION="Simple wrapper class for memory device context and DIB"
export CATEGORY=graphics
export TYPE=library
export VERSION=master
export VERSIONDATE=20260818
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=
export LICENSETYPE=
export DOWNLOADURL="https://github.com/tordex/simpledib/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/tordex/simpledib/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
wl-showstatus build &&
 ${CXX:-g++} -c -o dib.o dib.cpp -I. &&
 ${AR:-ar} cru libsimpledib.a dib.o &&
 ( echo "EXPORTS" && ${NM:-nm} -f posix --defined-only -p libsimpledib.a | sed -n -e "s/^\([^ ]*\) T .*$/\1/p; s/^_\{0,1\}\([^ ]*\) D .*$/\1 DATA/p" ) > simpledib.def &&
 ${CXX:-g++} -shared -s -mwindows -def simpledib.def -o simpledib.dll libsimpledib.a -Wl,--out-implib,libsimpledib.dll.a -lmsimg32 &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include/simpledib $INSTALLPREFIX/lib $INSTALLPREFIX/bin &&
 cp -f *.h $INSTALLPREFIX/include/simpledib/ &&
 cp -f *.a *.def $INSTALLPREFIX/lib/ &&
 cp -f *.dll $INSTALLPREFIX/bin/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



