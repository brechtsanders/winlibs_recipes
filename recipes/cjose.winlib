export NAME="C JOSE"
export STATUS=
export URL=https://github.com/cisco/cjose
export BASENAME=cjose
export DESCRIPTION="C library implementing the Javascript Object Signing and Encryption (JOSE)"
export CATEGORY=security
export TYPE=library
export VERSION=0.8.1
export VERSIONDATE=20260914
wl-showstatus --package-version
export DEPENDENCIES=openssl,libjansson
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/cisco/cjose/tags"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/cisco/cjose/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix CMakeLists.txt (version >= 0.8.1)
patch -ulbf CMakeLists.txt << EOF
@@ -167,3 +167,3 @@
     # (cjose_static) so it doesn't clash with the DLL's "cjose.lib" import lib.
-    if(NOT WIN32)
+    if(NOT MSVC)
         set_target_properties(cjose_static PROPERTIES OUTPUT_NAME cjose)
EOF
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DCJOSE_BUILD_STATIC:BOOL=ON -DCJOSE_BUILD_SHARED:BOOL=ON -DCJOSE_BUILD_TESTS:BOOL=OFF -S. -Bbuild_win &&
 wl-showstatus build-install &&
 ninja -Cbuild_win install/strip &&
 cp -f build_win/*.dll.a $INSTALLPREFIX/lib/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



