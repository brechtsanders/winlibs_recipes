export NAME="SDL_sound"
export STATUS=
export URL=https://icculus.org/SDL_sound/
#export URL=https://github.com/icculus/SDL_sound
export BASENAME=sdl3sound
export DESCRIPTION="SDL_sound is a library that handles the decoding of several popular sound file formats, such as .WAV and .MP3."
export CATEGORY=audio
export TYPE=library
export VERSION=3.2.0
export VERSIONDATE=20260908
wl-showstatus --package-version
export DEPENDENCIES=sdl3,libmikmod,libmodplug,smpeg,libogg,libvorbis,flac,libspeex
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE.txt
export LICENSETYPE=zlib
export DOWNLOADURL="https://github.com/icculus/SDL_sound/releases SDL_sound-"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/icculus/SDL_sound/releases/download/v$VERSION/SDL3_sound-$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/SDL3_sound-$VERSION.tar.gz
cd SDL3_sound-$VERSION
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DSDLSOUND_BUILD_STATIC:BOOL=ON -DSDLSOUND_BUILD_SHARED:BOOL=ON -S. -Bbuild_win &&
 wl-showstatus build-install &&
 ninja -Cbuild_win install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf SDL3_sound-$VERSION



