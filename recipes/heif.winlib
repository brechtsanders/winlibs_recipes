export NAME="HEIF"
export STATUS=
export URL=https://nokiatech.github.io/heif/
#export URL=https://github.com/nokiatech/heif
export BASENAME=heif
export DESCRIPTION="High Efficiency Image File Format (HEIF) - HEIF is a visual media container format standardized by the Moving Picture Experts Group (MPEG) for storage and sharing of images and image sequences. It is based on the well-known ISO Base Media File Format (ISOBMFF) standard. HEIF Reader/Writer Engine is an implementation of HEIF standard in order to demonstrate its powerful features and capabilities."
export CATEGORY=graphics,fileformat
export TYPE=library
export VERSION=4.0.0
export VERSIONDATE=20261016
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE.TXT
export LICENSETYPE=
export DOWNLOADURL="https://github.com/nokiatech/heif/releases"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/nokiatech/heif/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix srcs/api/common/heifexport.h (version >= 4.0.0)
patch -ulbf srcs/api/common/heifexport.h << EOF
@@ -66,3 +66,3 @@
     #if defined _WIN32 || defined __CYGWIN__
-        #ifdef HEIF_BUILDING_DLL
+        #if defined heif_shared_EXPORTS || defined heif_writer_shared_EXPORTS
             #ifdef __GNUC__
EOF
# fix srcs/reader/CMakeLists.txt (version >= 4.0.0)
patch -ulbf srcs/reader/CMakeLists.txt << EOF
@@ -111,2 +111,3 @@
 add_library(\${HEIF_LIB_NAME} STATIC \${READER_SRCS} \${API_HDRS} \${READER_HDRS} \$<TARGET_OBJECTS:common> \$<TARGET_OBJECTS:vvcparser>)
+set_target_properties(\${HEIF_LIB_NAME} PROPERTIES OUTPUT_NAME heif)
 set_property(TARGET \${HEIF_LIB_NAME} PROPERTY CXX_STANDARD 17)
@@ -123,2 +124,3 @@
     add_library(\${HEIF_SHARED_LIB_NAME} SHARED \${READER_SRCS} \${API_HDRS} \${READER_HDRS} \$<TARGET_OBJECTS:common> \$<TARGET_OBJECTS:vvcparser>)
+    set_target_properties(\${HEIF_SHARED_LIB_NAME} PROPERTIES OUTPUT_NAME heif)
     set_property(TARGET \${HEIF_SHARED_LIB_NAME} PROPERTY CXX_STANDARD 17)
EOF
# fix srcs/writer/CMakeLists.txt (version >= 4.0.0)
patch -ulbf srcs/writer/CMakeLists.txt << EOF
@@ -102,2 +102,3 @@
 add_library(\${HEIF_WRITER_LIB_NAME} STATIC \${WRITER_SRCS} \${API_HDRS} \${WRITER_HDRS} \$<TARGET_OBJECTS:common> \$<TARGET_OBJECTS:vvcparser>)
+set_target_properties(\${HEIF_WRITER_LIB_NAME} PROPERTIES OUTPUT_NAME heif_writer)

@@ -120,2 +121,3 @@
     add_library(\${HEIF_SHARED_WRITER_LIB_NAME} SHARED \${WRITER_SRCS} \${API_HDRS} \${WRITER_HDRS} \$<TARGET_OBJECTS:common> \$<TARGET_OBJECTS:vvcparser>)
+    set_target_properties(\${HEIF_SHARED_WRITER_LIB_NAME} PROPERTIES OUTPUT_NAME heif_writer)

EOF
# also allow building shared heifpp library in srcs/api-cpp/CMakeLists.txt (version >= 4.0.0)
sed -i.bak -e "s/\(add_library([^ ]*\) STATIC/\1/" srcs/api-cpp/CMakeLists.txt
# fix srcs/CMakeLists.txt (version >= 4.0.0)
sed -i.bak -e "1i cmake_minimum_required(VERSION 3.5)" srcs/CMakeLists.txt
## skip building examples in srcs/CMakeLists.txt (version >= 4.0.0)
#sed -i.bak2 -e "s/add_subdirectory(examples)/#&/" srcs/CMakeLists.txt
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX/share/heif -DCMAKE_BUILD_TYPE:STRING=Release -Ssrcs -Bbuild_win &&
 wl-showstatus build-install &&
 ninja -Cbuild_win install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION
####Conflicts with libheif => moved to different folder



