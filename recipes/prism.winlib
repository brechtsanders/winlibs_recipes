export NAME="prism"
export STATUS=
export URL=https://ruby.github.io/prism/
export BASENAME=prism
export DESCRIPTION="This is a parser for the Ruby programming language. It is designed to be portable, error tolerant, and maintainable. It is written in C99 and has no dependencies."
export CATEGORY=development
export TYPE=library
export VERSION=1.9.0
export VERSIONDATE=20260805
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE.md
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/ruby/prism/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
#export DOWNLOADSOURCEURL=https://github.com/ruby/prism/archive/refs/tags/v$VERSION.tar.gz
export DOWNLOADSOURCEURL=https://github.com/ruby/prism/releases/download/v$VERSION/libprism-src.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
mv -f $TARBALLDIR/$BASENAME/libprism-src.tar.gz $TARBALLDIR/$BASENAME/libprism-$VERSION.tar.gz
wl-wait4deps
wl-showstatus extract
#tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
#cd $BASENAME-$VERSION
mkdir -p $BASENAME-$VERSION
tar xz --force-local -f $TARBALLDIR/$BASENAME/libprism-$VERSION.tar.gz -C$BASENAME-$VERSION
cd $BASENAME-$VERSION/libprism-src
# fix building shared library
sed -i.bak -e "s/ -shared /&-s -Wl,--out-implib,\$@.a /" Makefile
wl-showstatus build &&
 make SOEXT=dll CC="${CC:-gcc}" AR="${AR:-ar}" &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include $INSTALLPREFIX/lib $INSTALLPREFIX/bin &&
 cp -rf include/* $INSTALLPREFIX/include/ &&
 cp -f build/*.a $INSTALLPREFIX/lib/ &&
 cp -f build/*.dll $INSTALLPREFIX/bin/ &&
 #wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd ../.. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



