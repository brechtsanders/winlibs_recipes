export NAME="p2c"
export STATUS=
export URL=https://github.com/FranklinChen/p2c
export BASENAME=p2c
export DESCRIPTION="Pascal to C compiler"
export CATEGORY=development
export TYPE=application
#export VERSION=1.21
#export VERSIONDATE=20200531
export VERSION=2.02.1
export VERSIONDATE=20261002
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=
export LICENSETYPE=
#export DOWNLOADURL="https://github.com/FranklinChen/p2c/releases"
export DOWNLOADURL="https://github.com/FranklinChen/p2c/tags"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
#export DOWNLOADSOURCEURL=https://github.com/FranklinChen/p2c/archive/$VERSION.tar.gz
export DOWNLOADSOURCEURL=https://github.com/FranklinChen/p2c/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix already defined unlink in src/trans.h (version >= 1.21)
patch -ulbf src/trans.h << EOF
@@ -1866,2 +1866,3 @@
 int link           PP( (char *, char *) );
+#define unlink P2C_unlink
 int unlink         PP( (char *) );
EOF
# use relative path for default P2C_HOME in src/trans.c (version >= 2.02.1)
patch -ulbf src/trans.c << EOF
@@ -33,2 +33,5 @@
 #include <time.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif

@@ -683,2 +686,6 @@

+#ifdef _WIN32
+    char p2c_home_buffer[MAX_PATH];
+    p2c_home = NULL;
+#endif
     i = 0;
@@ -692,2 +699,14 @@
     }
+#ifdef _WIN32
+    if (p2c_home == NULL) {
+      char* p;
+      if (GetModuleFileNameA(0, p2c_home_buffer, MAX_PATH) && (p = strrchr(p2c_home_buffer, '\\\\')) != NULL) {
+        *p = 0;
+        if ((p = strrchr(p2c_home_buffer, '\\\\')) != NULL) {
+          strcpy(p + 1, "lib\\\\p2c");
+          p2c_home = p2c_home_buffer;
+        }
+      }
+    }
+#endif
     init_stuff();
EOF
# fix mkdir in src/Makefile
sed -i.bak -e "s/mkdir /&-p /" src/Makefile
# fix building with LLVM/CLang
if ${CC:-gcc} --help -v 2>/dev/null | grep -q "\-Wimplicit-function-declaration" || ${CC:-gcc} --version|grep -q "^clang"; then
 sed -i.bak2 -e "s/^CFLAGS\s*=\s*/&-Wno-error=implicit-function-declaration /" src/Makefile
fi
# fix building with GCC 14 or higher
sed -i.bak3 -e "s/^CFLAGS\s*=\s*/&-Wno-incompatible-pointer-types /" src/Makefile
wl-showstatus build-install &&
 make install CC="${CC:-gcc} -std=c17" DEFS= HOMEDIR=$INSTALLPREFIX/lib/p2c INCDIR=$INSTALLPREFIX/include/p2c BINDIR=$INSTALLPREFIX/bin LIBDIR=$INSTALLPREFIX/lib MANDIR=$INSTALLPREFIX/man/man1 MANFILE=p2c.man.inst &&
 strip $INSTALLPREFIX/bin/*.exe &&
 sed -i "s?$(pwd)/home?\$(dirname \$0)/lib?g" $INSTALLPREFIX/bin/p2cc &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION
####P2C_HOME=$MINGWPREFIX/lib/p2c $MINGWPREFIX/bin/p2c.exe
####$MINGWPREFIX/bin/p2c.exe -H $MINGWPREFIX/lib/p2c
####$MINGWPREFIX/bin/p2c.exe



