export NAME="libspeechprovider"
export STATUS=
export URL=https://github.com/project-spiel/libspeechprovider
export BASENAME=libspeechprovider
export DESCRIPTION="This project includes the resources needed for building a Spiel speech provider."
export CATEGORY=audio
export TYPE=library
export VERSION=1.0.3
export VERSIONDATE=2026112
wl-showstatus --package-version
export DEPENDENCIES=gobject-introspection
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=meson,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=COPYING
export LICENSETYPE=Apache
export DOWNLOADURL="https://github.com/project-spiel/libspeechprovider/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/project-spiel/libspeechprovider/archive/refs/tags/SPEECHPROVIDER_$(echo $VERSION|tr . _).tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/SPEECHPROVIDER_$(echo $VERSION|tr . _).tar.gz
cd $BASENAME-SPEECHPROVIDER_$(echo $VERSION|tr . _)
# fix libspeechprovider/speech-provider-stream-writer.c (version >= 1.0.3)
patch -ulbf libspeechprovider/speech-provider-stream-writer.c << EOF
@@ -66,2 +66,3 @@
 {
+#ifdef F_GETFD
   if (fcntl (fd, F_GETFD) == -1)
@@ -71,2 +72,3 @@
     }
+#endif

EOF
# fix libspeechprovider/speech-provider-stream-reader.c (version >= 1.0.3)
patch -ulbf libspeechprovider/speech-provider-stream-reader.c << EOF
@@ -67,2 +67,3 @@
 {
+#ifdef F_GETFD
   if (fcntl (fd, F_GETFD) == -1)
@@ -72,2 +73,3 @@
     }
+#endif

EOF
# fix detection of Python
sed -i.bak -e "s?'python3'?'$(cygpath -w $PYDIR/python.exe|sed -e 's/\\/&&&&/g')'?" $(grep -l python3 $(find -name meson.build))
mkdir -p build_both &&
 wl-showstatus configure &&
 PYTHONPATH=${PYTHONPATH:+:$PYTHONPATH}:$MINGWPREFIX/lib $PYDIR/python.exe $(which meson.py) setup --prefix $INSTALLPREFIX --backend ninja --buildtype release --strip --default-library both -Dintrospection=true -Ddocs=false -Dtests=false $PWD build_both &&
 wl-showstatus build-install &&
 ninja -Cbuild_both install &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-SPEECHPROVIDER_$(echo $VERSION|tr . _)



