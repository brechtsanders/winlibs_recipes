export NAME="tablecruncher"
export STATUS=
export URL=https://github.com/Tablecruncher/tablecruncher
export BASENAME=tablecruncher
export DESCRIPTION="Tablecruncher is a blazing-fast CSV editor built to handle massive files with ease, available for macOS, Windows and Linux."
export CATEGORY=office
export TYPE=application
#export VERSION=1.8
#export VERSIONDATE=20260403
export VERSION=1.8.1
export VERSIONDATE=20260930
wl-showstatus --package-version
export DEPENDENCIES=fltk,duktape,cpp-httplib,nlohmann-json,utfcpp
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=GPL
export DOWNLOADURL="https://github.com/Tablecruncher/tablecruncher/releases"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/Tablecruncher/tablecruncher/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix src/helper.cpp (version >= 1.8.1)
patch -ulbf src/helper.cpp << EOF
@@ -650,3 +650,3 @@
                if (hModule != NULL) {
-               GetModuleFileName(hModule, own_path, MAX_PATH);
+               GetModuleFileNameA(hModule, own_path, MAX_PATH);
                        cpp_path = own_path;
@@ -801,3 +801,3 @@
 void Helper::openInputStream(std::ifstream& stream, const std::string& utf8Path, std::ios_base::openmode mode) {
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__MINGW32__)
        stream.open(utf8_to_ws(utf8Path), mode);
@@ -810,3 +810,3 @@
 void Helper::openOutputStream(std::ofstream& stream, const std::string& utf8Path, std::ios_base::openmode mode) {
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__MINGW32__)
        stream.open(utf8_to_ws(utf8Path), mode);
EOF
# fix missing wWinMain in src/main.cpp
cat >> src/main.cpp << EOF
int WINAPI wWinMain (HINSTANCE hInstance, HINSTANCE hPrevInstance, LPWSTR lpCmdLine, int nShowCmd)
{
    return WinMain(hInstance, hPrevInstance, GetCommandLineA(), nShowCmd);
}
EOF
# fix CMakeLists.txt (version >= 1.8.1)
patch -ulbf CMakeLists.txt << EOF
@@ -72,3 +72,3 @@
 # Detect the platform
-if(WIN32)
+if(MSVC)
     set(PLATFORM "Windows")
@@ -76,2 +76,5 @@
     set(LINKER_FLAGS "/NODEFAULTLIB:library")
+elseif(WIN32)
+    set(PLATFORM "Windows")
+    set(CMAKE_CXX_FLAGS "\${CMAKE_CXX_FLAGS} -municode -DMY_VERSION=\\\\\\"\${APP_VERSION}\\\\\\" -DMY_YEAR=\\\\\\"\${YEAR}\\\\\\" -DMY_TODAY=\\\\\\"\${TODAY}\\\\\\" -DMY_NOW=\\\\\\"\${NOW}\\\\\\"  -D_FILE_OFFSET_BITS=64 -DWIN32_LEAN_AND_MEAN -DNOMINMAX")
 elseif(APPLE)
EOF
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DFLTKDIR:PATH=$MINGWPREFIX -S. -Bbuild_win &&
 wl-showstatus build &&
 ninja -Cbuild_win &&
 wl-showstatus build-install &&
 strip build_win/dist/*.exe &&
 mkdir -p $INSTALLPREFIX/bin &&
 cp -f build_win/dist/*.exe $INSTALLPREFIX/bin/ &&
 #ninja -Cbuild_win install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION
####$MINGWPREFIX/bin/Tablecruncher.exe



