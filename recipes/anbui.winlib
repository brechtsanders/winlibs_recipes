export NAME="anbui"
export STATUS=
export URL=https://github.com/oerg866/anbui
export BASENAME=anbui
export DESCRIPTION="(Very) Tiny Text UI library"
export CATEGORY=tui
export TYPE=library
export VERSION=master
export VERSIONDATE=20260731
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=README.md
export LICENSETYPE=CC-BY-NC
export DOWNLOADURL="https://github.com/oerg866/anbui/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/oerg866/anbui/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
wl-showstatus build &&
 touch SUCCESS &&
 for F in $(sh get_build_files.sh); do
  echo CC $F &&
  ${CC:-gcc} -c -o $(basename $F.o) $F -I. || (rm -f SUCCESS; false ) || break
 done &&
 rm SUCCESS &&
 ${AR:-ar} cru libanbui.a *.o &&
 ( echo "EXPORTS" && ${NM:-nm} -f posix --defined-only -p libanbui.a | sed -n -e "s/^_\{0,1\}\([^ ]*\) T .*$/\1/p; s/^_\{0,1\}\([^ ]*\) D .*$/\1 DATA/p" ) > anbui.def &&
 ${CC:-gcc} -shared -s -mwindows -def anbui.def -o anbui.dll libanbui.a -Wl,--out-implib,libanbui.dll.a &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include $INSTALLPREFIX/lib $INSTALLPREFIX/bin &&
 cp -f anbui.h $INSTALLPREFIX/include/ &&
 cp -f *.a *.def $INSTALLPREFIX/lib/ &&
 cp -f *.dll $INSTALLPREFIX/bin/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



