export NAME="LPython"
export STATUS=
export URL=https://lpython.org/
#export URL=https://github.com/lcompilers/lpython
export BASENAME=lpython
export DESCRIPTION="High performance typed Python compiler"
export CATEGORY=development
export TYPE=application
export VERSION=0.22.0
export VERSIONDATE=20261025
wl-showstatus --package-version
export DEPENDENCIES=libffi,libxml2,zlib,json,fmt
#export DEPENDENCIES=llvm-project,libffi,libxml2,zlib,json,fmt
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=BSD
export DOWNLOADURL="https://github.com/lcompilers/lpython/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/lcompilers/lpython/releases/download/v$VERSION/$BASENAME-$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$BASENAME-$VERSION.tar.gz
cd $BASENAME-$VERSION
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DWITH_LLVM:BOOL=OFF -DWITH_RUNTIME_LIBRARY:BOOL=ON -DWITH_ZLIB:BOOL=ON -DWITH_JSON:BOOL=ON -DWITH_FMT:BOOL=ON -S. -Bbuild_win &&
 #-DWITH_LLVM:BOOL=ON -DLLVM_DIR:PATH=$MINGWPREFIX/share/llvm/lib/cmake/llvm 
 wl-showstatus build-install &&
 ninja -Cbuild_win install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



echo 'print("Hello World!")' > hello.py
$PYDIR/python.exe hello.py
$MINGWPREFIX/bin/lpython.exe hello.py
