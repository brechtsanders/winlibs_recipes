export NAME="ExprTk"
export STATUS=
export URL=https://www.partow.net/programming/exprtk/
#export URL=https://github.com/arashpartow/exprtk
export BASENAME=exprtk
export DESCRIPTION="C++ mathematical expression parsing and evaluation library"
export CATEGORY=dataprocessing,math
export TYPE=library
export VERSION=0.0.3
export VERSIONDATE=20261106
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=license.txt
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/ArashPartow/exprtk/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/ArashPartow/exprtk/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix Makefile
sed -i.bak -e "s/:=/=/" Makefile
#sed -i.bak -e "s/:=/=/; s/\(:%\.cpp=%\)\()\)/\1.exe\2/" Makefile
#wl-showstatus build &&
# mingw32-make COMPILER="${CXX:-g++}" &&
#    echo OK
wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include &&
 cp -f *.hpp $INSTALLPREFIX/include/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



