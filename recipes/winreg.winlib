export NAME="WinReg"
export STATUS=
export URL=https://github.com/GiovanniDicanio/WinReg
export BASENAME=winreg
export DESCRIPTION="Convenient high-level C++ wrapper around the Windows Registry API"
export CATEGORY=development
export TYPE=library
#export VERSION=6.1.0
#export VERSIONDATE=20231219
#export VERSION=6.1.1
#export VERSIONDATE=20240215
#export VERSION=6.2.0
#export VERSIONDATE=20240223
#export DEPENDENCIES=
#export OPTIONALDEPENDENCIES=
#export BUILDDEPENDENCIES=cmakeconverter,cmake,ninja
#export OPTIONALBUILDDEPENDENCIES=
#export VERSION=6.3.0
#export VERSIONDATE=20240917
#export VERSION=6.3.1
#export VERSIONDATE=20241025
#export VERSION=6.3.2
#export VERSIONDATE=20241107
#export VERSION=6.4.0
#export VERSIONDATE=20250823
#export VERSION=6.5.0
#export VERSIONDATE=20260724
#export VERSION=6.5.1
#export VERSIONDATE=20260725
#export VERSION=7.0.1
#export VERSIONDATE=20260820
#export VERSION=8.0.0
#export VERSIONDATE=20260822
#export VERSION=10.0.0
#export VERSIONDATE=20261015
export VERSION=12.0.0
export VERSIONDATE=20261021
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmakeconverter,cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/GiovanniDicanio/WinReg/tags"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/GiovanniDicanio/WinReg/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd WinReg-$VERSION
wl-showstatus preconfigure
 PATH=$PYDIR:$PATH PYTHONPATH=$MINGWPREFIX/python/Lib/site-packages:$PYDIR/Lib/site-packages${PYTHONPATH:+:$PYTHONPATH} $MINGWPREFIX/python/Scripts/cmake-converter-script.py -s WinReg.sln &&
 wl-showstatus configure
 mkdir -p build_win &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -S. -Bbuild_win &&
 wl-showstatus build &&
 ninja -Cbuild_win &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include &&
 cp -rf Include/WinReg $INSTALLPREFIX/include/ &&
 #wl-showstatus build-install &&
 #ninja -Cbuild_win install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf WinReg-$VERSION



