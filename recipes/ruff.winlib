export NAME="Ruff"
export STATUS=
export URL=https://docs.astral.sh/ruff/
#export URL=https://github.com/astral-sh/ruff
export BASENAME=ruff
export DESCRIPTION="An extremely fast Python linter and code formatter, written in Rust."
export CATEGORY=development
export TYPE=application
#export VERSION=0.17.2
#export VERSIONDATE=20261024
export VERSION=0.17.3
export VERSIONDATE=20261027
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=rust
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/astral-sh/ruff/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/astral-sh/ruff/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
wl-showstatus build &&
 #GIT_CONFIG_GLOBAL=config GIT_SSL_NO_VERIFY=true CARGO_NET_GIT_FETCH_WITH_CLI=true \
 CARGO_HOME=${CARGO_HOME:-$PWD/rustdeps} PATH=$MINGWPREFIX/share/rust/bin:$PATH \
 cargo build --release --target-dir build_win &&
 strip build_win/release/*.{dll,exe} &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/share/ruff/bin &&
 cp -f build_win/release/*.{dll,exe} $INSTALLPREFIX/share/ruff/bin/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



