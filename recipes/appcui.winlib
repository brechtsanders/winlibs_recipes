export NAME="AppCUI"
export STATUS=
export URL=https://gdt050579.github.io/AppCUI/
#export URL=https://github.com/gdt050579/AppCUI
export BASENAME=appcui
export DESCRIPTION="AppCUI is a cross-platform TUI builder. The users of this library can construct an interface using its basic building blocks such as: Window, Button, Label, etc."
export CATEGORY=tui
export TYPE=library
#export VERSION=1.241.0
#export VERSIONDATE=20261009
#export VERSION=1.250.0
#export VERSIONDATE=20261011
export VERSION=1.251.0
export VERSIONDATE=20261012
wl-showstatus --package-version
export DEPENDENCIES=zlib,libbz2,libjpeg,libpng,libjpeg-turbo,freetype2,sdl2,sdl2ttf,brotli
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/gdt050579/AppCUI/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/gdt050579/AppCUI/archive/refs/tags/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd AppCUI-$VERSION
# fix missing #include <algorithm>
sed -i.bak -e "1i #include <algorithm>" Examples/Snake/Board.cpp Examples/Tetris/Board.cpp AppCUI/src/Controls/TreeView.cpp AppCUI/src/Utils/IniObject.cpp
sed -i.bak -e "1i #include <chrono>" Examples/TreeView/main.cpp
## fix AppCUI/include/AppCUI.hpp (version = 1.241.0)
#patch -ulbf AppCUI/include/AppCUI.hpp << EOF
#@@ -40,3 +40,7 @@
# #    ifdef BUILD_FOR_WINDOWS
#+#      ifdef AppCUI_EXPORTS
# #        define EXPORT __declspec(dllexport)
#+#      else
#+#        define EXPORT __declspec(dllimport)
#+#      endif
# #    else
#EOF
# fix AppCUI/include/AppCUI.hpp (version >= 1.250.0)
patch -ulbf AppCUI/include/AppCUI.hpp << EOF
@@ -38,3 +38,11 @@

-#ifdef BUILD_AS_DYNAMIC_LIB
+#ifdef _WIN32
+#    if BUILD_AS_DYNAMIC_LIB //defined(AppCUI_EXPORTS)
+#        define EXPORT __declspec(dllexport)
+#    elif !defined(STATIC)
+#        define EXPORT __declspec(dllimport)
+#    else
+#        define EXPORT
+#    endif
+#elif defined(BUILD_AS_DYNAMIC_LIB)
 #    ifdef BUILD_FOR_WINDOWS
EOF
# fix AppCUI/src/OS/Windows/File.cpp (version >= 1.250.0)
sed -i.bak -e "1i #include <algorithm>" AppCUI/src/OS/Windows/File.cpp
# fix AppCUI/src/OS/Windows/Library.cpp (version >= 1.250.0)
patch -ulbf AppCUI/src/OS/Windows/Library.cpp << EOF
@@ -25,3 +25,3 @@
     // all good
-    void* fnPtr = GetProcAddress((HMODULE) this->libraryHandle, functionName);
+    void* fnPtr = (void*)GetProcAddress((HMODULE) this->libraryHandle, functionName);
     CHECK(fnPtr, nullptr, "Unable to find address of function: %s", functionName);
EOF
# fix AppCUI/src/OS/CMakeLists.txt (version >= 1.250.0)
patch -ulbf AppCUI/src/OS/CMakeLists.txt << EOF
@@ -1,3 +1,3 @@
 target_sources(AppCUICore PRIVATE DataObject.cpp DateTime.cpp StaticFileMethods.cpp MemoryFile.cpp)
-if (MSVC)
+if (WIN32)
     add_subdirectory(Windows)
EOF
## fix AppCUI/CMakeLists.txt (version = 1.241.0)
##sed -i.bak -e "s/\(find_package(\)unofficial-\(brotli\)/\1\2/" AppCUI/CMakeLists.txt
#patch -ulbf AppCUI/CMakeLists.txt << EOF
#@@ -38,3 +38,5 @@
# set_target_properties(\${PROJECT_NAME} PROPERTIES PREFIX "lib")
#+if(BUILD_SHARED_LIBS)
# target_compile_definitions(\${PROJECT_NAME} PRIVATE -DBUILD_AS_DYNAMIC_LIB)
#+endif()
#
#@@ -51,3 +53,9 @@
#
#-find_package(unofficial-brotli CONFIG REQUIRED)
#+find_package(unofficial-brotli CONFIG)
#+if (NOT TARGET unofficial-brotli)
#+  find_package(PkgConfig QUIET)
#+  if(PkgConfig_FOUND)
#+    pkg_check_modules(unofficial-brotli libbrotlicommon REQUIRED)
#+  endif()
#+endif()
# find_package(BZip2 REQUIRED)
#EOF
# fix AppCUI/CMakeLists.txt (version >= 1.250.0)
patch -ulbf AppCUI/CMakeLists.txt << EOF
@@ -5,3 +5,3 @@

-if( supported )
+if( supported AND NOT MINGW )
        message(STATUS "\${PROJECT_NAME} => IPO / LTO enabled")
@@ -65,3 +65,5 @@
     set_target_properties(\${target} PROPERTIES POSITION_INDEPENDENT_CODE ON FOLDER "AppCUI")
+  if(BUILD_SHARED_LIBS)
     target_compile_definitions(\${target} PRIVATE -DBUILD_AS_DYNAMIC_LIB)
+  endif()
 endfunction()
@@ -113,3 +115,9 @@

-    find_package(unofficial-brotli CONFIG REQUIRED)
+    find_package(unofficial-brotli CONFIG)
+    if (NOT TARGET unofficial-brotli)
+      find_package(PkgConfig QUIET)
+      if(PkgConfig_FOUND)
+        pkg_check_modules(unofficial-brotli libbrotlicommon REQUIRED)
+      endif()
+    endif()
     find_package(BZip2 REQUIRED)
@@ -229,3 +237,3 @@
 # ---------------------------------------------------------------------------------------------------------------------
-add_library(\${PROJECT_NAME} SHARED)
+add_library(\${PROJECT_NAME})

EOF
## fix CMakeLists.txt (version = 1.241.0)
#patch -ulbf CMakeLists.txt << EOF
#@@ -2,4 +2,2 @@
#
#-set(CMAKE_TOOLCHAIN_FILE "\${CMAKE_CURRENT_SOURCE_DIR}/vcpkg/scripts/buildsystems/vcpkg.cmake"
#-  CACHE STRING "Vcpkg toolchain file")
#
#@@ -25,2 +23,4 @@
#     add_compile_options(-W3 /MP)
#+elseif (WIN32)
#+    add_definitions(-DBUILD_FOR_WINDOWS)
# elseif (APPLE)
#EOF
# fix CMakeLists.txt (version >= 1.250.0)
patch -ulbf CMakeLists.txt << EOF
@@ -2,4 +2,2 @@

-set(CMAKE_TOOLCHAIN_FILE "\${CMAKE_CURRENT_SOURCE_DIR}/vcpkg/scripts/buildsystems/vcpkg.cmake"
-  CACHE STRING "Vcpkg toolchain file")

@@ -25,2 +23,4 @@
     add_compile_options(-W3 /MP)
+elseif (WIN32)
+    add_definitions(-DBUILD_FOR_WINDOWS)
 elseif (APPLE)
@@ -108,3 +108,3 @@
 if(APPCUI_ENABLE_TESTS)
-    if (NOT UNIX)
+    if (NOT UNIX AND NOT MINGW)
         add_subdirectory(Tests/Tester)
EOF
# disable examples and tests
sed -i.bak -e "s/set(APPCUI_ENABLE_\(EXAMPLES\|TESTS\) 1)/#&/" CMakeLists.txt
# also allow building static library
sed -i.bak -e "s/\(add_library([^ ]*\) SHARED/\1/" AppCUI/CMakeLists.txt
mkdir -p build_static build_shared &&
 wl-showstatus configure-static &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_SHARED_LIBS:BOOL=OFF -Dlibjpeg-turbo_DIR:PATH=$MINGWPREFIX/share/libjpeg-turbo/lib/cmake/libjpeg-turbo -DCMAKE_CXX_STANDARD:STRING=20 -DCMAKE_CXX_FLAGS:STRING="-DSTATIC" -S. -Bbuild_static &&
 wl-showstatus configure-shared &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_SHARED_LIBS:BOOL=ON -Dlibjpeg-turbo_DIR:PATH=$MINGWPREFIX/share/libjpeg-turbo/lib/cmake/libjpeg-turbo -DCMAKE_CXX_STANDARD:STRING=20 -S. -Bbuild_shared &&
 wl-showstatus build-static &&
 ninja -Cbuild_static libAppCUI.a &&
 wl-showstatus build-shared &&
 ninja -Cbuild_shared &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/{include,lib,bin} &&
 cp -f AppCUI/include/*.hpp $INSTALLPREFIX/include/ &&
 cp -f bin/*.a $INSTALLPREFIX/lib/ &&
 cp -f bin/*.dll $INSTALLPREFIX/bin/ &&
 #wl-showstatus build-install-static &&
 #ninja -Cbuild_static install/strip &&
 #wl-showstatus build-install-shared &&
 #ninja -Cbuild_shared install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf AppCUI-$VERSION
###PATH=$MINGWPREFIX/share/libjpeg-turbo/bin:$PATH



