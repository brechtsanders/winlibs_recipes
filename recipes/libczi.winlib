export NAME="libCZI"
export STATUS=
export URL=https://zeiss.github.io/libczi/
#export URL=https://github.com/ZEISS/libczi
export BASENAME=libczi
export DESCRIPTION="libCZI is an Open Source Cross-Platform C++ library to read and write CZI (image format for microscopes)."
export CATEGORY=science,fileformat
export TYPE=library
export VERSION=main
export VERSIONDATE=20260908
wl-showstatus --package-version
export DEPENDENCIES=liblz4,zstd,libcurl,rapidjson,eigen
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=COPYING
export LICENSETYPE=LGPL
export DOWNLOADURL="https://github.com/ZEISS/libczi/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/ZEISS/libczi/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
mkdir -p build_win &&
 wl-showstatus configure &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DLIBCZI_ENABLE_INSTALL:BOOL=ON -DLIBCZI_BUILD_PREFER_EXTERNALPACKAGE_EIGEN3:BOOL=ON -DLIBCZI_BUILD_PREFER_EXTERNALPACKAGE_LIBCURL:BOOL=ON -DLIBCZI_BUILD_PREFER_EXTERNALPACKAGE_LZ4:BOOL=ON -DLIBCZI_BUILD_PREFER_EXTERNALPACKAGE_RAPIDJSON:BOOL=ON -DLIBCZI_BUILD_PREFER_EXTERNALPACKAGE_ZSTD:BOOL=ON -DFETCHCONTENT_FULLY_DISCONNECTED:BOOL=ON -DCMAKE_TLS_VERIFY:BOOL=OFF -DLIBCZI_BUILD_UNITTESTS:BOOL=OFF -DBUILD_TESTING:BOOL=OFF -S. -Bbuild_win &&
 wl-showstatus build-install &&
 ninja -Cbuild_win install/strip &&
 cp build_win/Src/libCZI/liblibCZIStatic.a $INSTALLPREFIX/lib/liblibCZI.a &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



