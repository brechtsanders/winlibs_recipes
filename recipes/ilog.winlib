export NAME="ILog"
export STATUS=
export URL=https://github.com/Immanuel-C/ILog
export BASENAME=ilog
export DESCRIPTION="The ILog is for people who need a simple logger. Currently for windows and linux only. This logger is for C/C++."
export CATEGORY=
export TYPE=library
export VERSION=main
export VERSIONDATE=20261021
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/Immanuel-C/ILog/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/Immanuel-C/ILog/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd ILog-$VERSION
# avoid missing DebugBreak.h
sed -i.bak -e "s?^#include \"DebugBreak\.h\"?//&?" ILog.h
wl-showstatus build &&
 ${CC:-gcc} -c -o ILog.o ILog.c -I. -O3 &&
 ${CC:-gcc} -c -o example.o example.c -I. -O3 &&
 ${AR:-ar} cru libILog.a ILog.o &&
 ( echo "EXPORTS" && ${NM:-nm} -f posix --defined-only -p libILog.a | sed -n -e "s/^\([^ ]*\) T .*$/\1/p; s/^\([^ ]*\) D .*$/\1 DATA/p" ) > ILog.def &&
 ${CC:-gcc} -shared -s -mwindows -def ILog.def -o ILog.dll libILog.a -Wl,--out-implib,libILog.dll.a &&
 ${CC:-gcc} -o example.exe example.o libILog.dll.a &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include $INSTALLPREFIX/lib $INSTALLPREFIX/bin &&
 cp -f *.h $INSTALLPREFIX/include/ &&
 cp -f *.a *.def $INSTALLPREFIX/lib/ &&
 cp -f *.dll $INSTALLPREFIX/bin/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf ILog-$VERSION



