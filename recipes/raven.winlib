export NAME="Raven"
export STATUS=
export URL=https://oscar-soirey.github.io/Raven/
#export URL=https://github.com/oscar-soirey/Raven
export BASENAME=raven
export DESCRIPTION="A lightweight, multithreaded GUI library in C for editors and tools."
export CATEGORY=gui
export TYPE=library
export VERSION=0.2.0
export VERSIONDATE=20261031
wl-showstatus --package-version
export DEPENDENCIES=pthreads,stb
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=cmake,ninja
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=Apache
export DOWNLOADURL="https://github.com/oscar-soirey/Raven/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/oscar-soirey/Raven/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
mkdir -p build_static build_shared &&
 wl-showstatus configure-static &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_SHARED_LIBS:BOOL=OFF -DRAVEN_BUILD_SHARED:BOOL=OFF -DRAVEN_WITH_STB_IMAGE:BOOL=ON -DRAVEN_BACKEND_VULKAN:BOOL=ON -DRAVEN_REBUILD_SHADERS:BOOL=ON -DRAVEN_BUILD_WEB:BOOL=ON -DRAVEN_BUILD_TOOLS:BOOL=ON -DRAVEN_BUILD_EXAMPLES:BOOL=OFF -DRAVEN_BUILD_TESTS:BOOL=OFF -S. -Bbuild_static &&
 wl-showstatus configure-shared &&
 cmake.exe -Wno-dev -GNinja -DCMAKE_INSTALL_PREFIX:PATH=$INSTALLPREFIX -DCMAKE_BUILD_TYPE:STRING=Release -DBUILD_SHARED_LIBS:BOOL=ON -DRAVEN_BUILD_SHARED:BOOL=ON -DRAVEN_WITH_STB_IMAGE:BOOL=ON -DRAVEN_BACKEND_VULKAN:BOOL=ON -DRAVEN_REBUILD_SHADERS:BOOL=ON -DRAVEN_BUILD_WEB:BOOL=ON -DRAVEN_BUILD_TOOLS:BOOL=ON -DRAVEN_BUILD_EXAMPLES:BOOL=OFF -DRAVEN_BUILD_TESTS:BOOL=OFF -S. -Bbuild_shared &&
 wl-showstatus build-install-static &&
 ninja -Cbuild_static install/strip &&
 wl-showstatus build-install-shared &&
 ninja -Cbuild_shared install/strip &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



