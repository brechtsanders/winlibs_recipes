export NAME="ts-rust (aka tsc-rs)"
export STATUS=
export URL=https://tsz.dev/
#export URL=https://github.com/pingdotgg/ts-rust
export BASENAME=ts-rust
export DESCRIPTION="An experimental Rust port of the TypeScript 7 compiler (tsc)"
export CATEGORY=development
export TYPE=application
export VERSION=0.8.0
export VERSIONDATE=20261106
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/pingdotgg/ts-rust/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/pingdotgg/ts-rust/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd ts-rust-$VERSION
wl-showstatus build &&
 #GIT_CONFIG_GLOBAL=config GIT_SSL_NO_VERIFY=true CARGO_NET_GIT_FETCH_WITH_CLI=true \
 CARGO_HOME=${CARGO_HOME:-$PWD/rustdeps} PATH=$MINGWPREFIX/share/rust/bin:$PATH \
 cargo build --release --target-dir build_win &&
 strip build_win/release/*.exe &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/share/ts-rust &&
 cp -rf build_win/release/* $INSTALLPREFIX/share/ts-rust/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf ts-rust-$VERSION
####Note: the following environment variable may be needed to use in scripts: TS_GO_REPO=$MINGWPREFIX/share/ts-rust
####$MINGWPREFIX/share/ts-rust/goport.exe
####$MINGWPREFIX/share/ts-rust/tsgo.exe



