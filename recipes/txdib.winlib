export NAME="TxDIB"
export STATUS=
export URL=https://github.com/tordex/txdib
export BASENAME=txdib
export DESCRIPTION="Simple wrapper for FreeImage library"
export CATEGORY=graphics
export TYPE=library
export VERSION=master
export VERSIONDATE=20260818
wl-showstatus --package-version
export DEPENDENCIES=freeimage
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=
export LICENSETYPE=
export DOWNLOADURL="https://github.com/tordex/txdib/tags"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/tordex/txdib/archive/refs/heads/$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix TxDIB.cpp
sed -i.bak -e 's?"\.\.\\freeimage\\FreeImage\.h"?<FreeImage.h>?' TxDIB.cpp
wl-showstatus build &&
 ${CXX:-g++} -c -o TxDIB.o TxDIB.cpp -I. &&
 ${AR:-ar} cru libTxDIB.a TxDIB.o &&
 ( echo "EXPORTS" && ${NM:-nm} -f posix --defined-only -p libTxDIB.a | sed -n -e "s/^\([^ ]*\) T .*$/\1/p; s/^_\{0,1\}\([^ ]*\) D .*$/\1 DATA/p" ) > TxDIB.def &&
 ${CXX:-g++} -shared -s -mwindows -def TxDIB.def -o TxDIB.dll libTxDIB.a -Wl,--out-implib,libTxDIB.dll.a -lFreeImage -lmsimg32 &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include $INSTALLPREFIX/lib $INSTALLPREFIX/bin &&
 cp -f *.h $INSTALLPREFIX/include/ &&
 cp -f *.a *.def $INSTALLPREFIX/lib/ &&
 cp -f *.dll $INSTALLPREFIX/bin/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



