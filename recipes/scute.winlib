export NAME="Scute"
export STATUS=
export URL=https://www.gnupg.org/software/scute/
export BASENAME=scute
export DESCRIPTION="Scute is a PKCS#11 provider on top of GnuPG allowing the use of GnuPG supported smartcards with Mozilla's Network Security Services and other software supporting the PKCS#11 specification."
export CATEGORY=security
export TYPE=library
export VERSION=1.7.0
export VERSIONDATE=20260924
wl-showstatus --package-version
export DEPENDENCIES=libgpg-error,libassuan
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=imagemagick
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=COPYING.LESSER
export LICENSETYPE=LGPL
#export DOWNLOADURL="https://www.gnupg.org/download/"
export DOWNLOADURL="https://www.gnupg.org/ftp/gcrypt/scute/"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://www.gnupg.org/ftp/gcrypt/scute/$BASENAME-$VERSION.tar.bz2
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xj --force-local -f $TARBALLDIR/$BASENAME/$BASENAME-$VERSION.tar.bz2
cd $BASENAME-$VERSION
wl-showstatus configure &&
 ./configure --prefix=$INSTALLPREFIX --build=$BUILDPLATFORM --host=$RUNPLATFORM --enable-static --enable-shared --with-libgpg-error-prefix=$MINGWPREFIX -with-libassuan-prefix=$MINGWPREFIX --enable-doc LDFLAGS="-Wl,--allow-multiple-definition" &&
 # fix building DLLs
 sed -i.bak -e "s/\(allow_undefined=\)yes/\1no/" libtool &&
 wl-showstatus build-install &&
 MAGICK_CODER_MODULE_PATH=$MINGWPREFIX/lib/ImageMagick-$(magick -version|sed -ne "s/^.*ImageMagick \([0-9]*\.[0-9]*\.[0-9]*\).*$/\1/p")/modules-Q16HDRI/coders MAGICK_CODER_FILTER_PATH=$MINGWPREFIX/lib/ImageMagick-$(magick -version|sed -ne "s/^.*ImageMagick \([0-9]*\.[0-9]*\.[0-9]*\).*$/\1/p")/modules-Q16HDRI/filters \
 make install-strip &&
 strip $INSTALLPREFIX/lib/*.dll &&
 mkdir -p $INSTALLPREFIX/bin &&
 mv -f $INSTALLPREFIX/lib/*.dll $INSTALLPREFIX/bin/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



