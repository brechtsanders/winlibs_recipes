export NAME="tsrs"
export STATUS=
export URL=https://github.com/oxc-project/tsrs
export BASENAME=tsrs
export DESCRIPTION="tsrs is a drop-in replacement for the TypeScript 7 compiler and language server, written in Rust."
export CATEGORY=development
export TYPE=application
#export VERSION=0.22.0
#export VERSIONDATE=20261106
#export VERSION=0.23.0
#export VERSIONDATE=20261107
export VERSION=0.24.0
export VERSIONDATE=20261111
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=rust
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=Apache
export DOWNLOADURL="https://github.com/oxc-project/tsrs/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/oxc-project/tsrs/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
wl-showstatus build &&
 #GIT_CONFIG_GLOBAL=config GIT_SSL_NO_VERIFY=true CARGO_NET_GIT_FETCH_WITH_CLI=true \
 CARGO_HOME=${CARGO_HOME:-$PWD/rustdeps} PATH=$MINGWPREFIX/share/rust/bin:$PATH \
 RUSTFLAGS="-ladvapi32" \
 cargo build --release --target-dir build_win &&
 wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/share/tsrs &&
 cp -rf build_win/release/* $INSTALLPREFIX/share/tsrs/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION
####$MINGWPREFIX/share/tsrs/tsrs.exe



