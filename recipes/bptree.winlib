export NAME="bptree"
export STATUS=
export URL=https://github.com/habedi/bptree
export BASENAME=bptree
export DESCRIPTION="A B+ tree implementation in C"
export CATEGORY=dataprocessing
export TYPE=library
export VERSION=0.5.1
export VERSIONDATE=20261016
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=LICENSE
export LICENSETYPE=MIT
export DOWNLOADURL="https://github.com/habedi/bptree/releases"
export INSTALLPREFIX=$PWD/inst_$BASENAME-$VERSION
export DOWNLOADSOURCEURL=https://github.com/habedi/bptree/archive/refs/tags/v$VERSION.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
tar xz --force-local -f $TARBALLDIR/$BASENAME/v$VERSION.tar.gz
cd $BASENAME-$VERSION
# fix include/bptree.h (version >= 0.5.1)
patch -ulbf include/bptree.h << EOF
@@ -824,3 +824,7 @@
     size = (size + max_align - 1) & ~(max_align - 1);
+#ifdef _WIN32
+    bptree_node* node = _aligned_malloc(size, max_align);
+#else
     bptree_node* node = aligned_alloc(max_align, size);
+#endif
     if (node) {
EOF
# fix test/extras/test_safety.c (version >= 0.5.1)
patch -ulbf test/extras/test_safety.c << EOF
@@ -17,3 +17,7 @@
     if (fail_after > 0) fail_after--;
+#ifdef _WIN32
+    return _aligned_malloc(size, alignment);
+#else
     return aligned_alloc(alignment, size);
+#endif
 }
EOF
#wl-showstatus build &&
# make release CC="${CC:-gcc}" ENABLE_ASAN=0 &&
#    echo OK
wl-showstatus install &&
 mkdir -p $INSTALLPREFIX/include &&
 cp -f include/*.h $INSTALLPREFIX/include/ &&
 wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION



